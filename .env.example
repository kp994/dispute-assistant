# AI provider: gemini (free tier) or claude. When unset, uses whichever key is set.
# AI_PROVIDER=gemini

# Gemini: free key at https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Claude (paid): key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# PayPal sandbox REST app (optional; demo cases work without it)
# Create one at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal's hosted MCP server, used by "Investigate in PayPal" when the provider is Claude
# (Gemini calls the same read-only lookups through this server's PayPal REST client)
# PAYPAL_MCP_READ_TOOLS=get_dispute,list_transactions,get_shipment_tracking,get_order

# Optional
# PORT=3000
# AI_REQUESTS_PER_HOUR=40
# DATA_FILE=./data/cases.json
